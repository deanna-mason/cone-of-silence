# Base URL of the server's HTTP API.
NEXT_PUBLIC_API_URL=http://localhost:8787

# Base URL of the server's WebSocket signaling endpoint.
NEXT_PUBLIC_SIGNALING_URL=ws://localhost:8787/ws

# STUN server used for WebRTC ICE gathering; falls back to a public Google
# STUN server if unset.
NEXT_PUBLIC_STUN_URL=stun:stun.l.google.com:19302
